{
  "name": "ugit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "description": "Minimal Next.js App Router starter for ugit.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm run build:web && pnpm run build:cli",
    "build:web": "next build",
    "build:cli": "pnpm --filter ugit-cli build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm exec next typegen && tsc --noEmit",
    "fmt": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,md}\"",
    "fmt:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,md}\"",
    "format": "pnpm fmt",
    "format:check": "pnpm fmt:check"
  },
  "dependencies": {
    "better-sqlite3": "12.8.0",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.3",
    "eslint-config-next": "16.1.6",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
